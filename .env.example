# Copy to .env and fill in. Never commit .env.

# ── Supabase (Project Settings → Database / API) ──────────────────────────────
# Use the "Session pooler" connection string, with your database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable ("anon") key: used by the web app to sign you in
SUPABASE_ANON_KEY=
# Secret ("service_role") key: server only, never share or commit
SUPABASE_SERVICE_ROLE_KEY=
# Legacy JWT secret: only needed if your project still uses it (newer projects sign with keys the API fetches itself)
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=documents

# ── LLM (swappable) ───────────────────────────────────────────────────────────
# "anthropic" for Claude, or "openai_compatible" for a local/sovereign model
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# For a local model, e.g. Ollama:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=llama3.1:70b
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1

# ── TypeSafe Jev (optional: email triage with calibrated confidence) ─────────
TYPESAFE_API_KEY=
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# ── Microsoft Graph (from your M365 admin) ────────────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=

CORS_ORIGINS=http://localhost:3000
