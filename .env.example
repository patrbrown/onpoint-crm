# Copy to .env and fill in. Never commit .env.

# ── Supabase (Project Settings → Database / API) ──────────────────────────────
# Use the "Session pooler" connection string, with your database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
STORAGE_BUCKET=documents

# Local only: act as this Supabase user without logging in (until the web UI exists). Remove in the cloud.
DEV_USER_ID=

# ── LLM (swappable) ───────────────────────────────────────────────────────────
LLM_PROVIDER=anthropic                 # or openai_compatible for a local/sovereign model
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# For a local model, e.g. Ollama:
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=llama3.1:70b
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1

# ── Microsoft Graph (from your M365 admin) ────────────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=

CORS_ORIGINS=http://localhost:3000
